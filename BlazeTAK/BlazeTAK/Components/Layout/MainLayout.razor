@inherits LayoutComponentBase

<div class="page">
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" title="Toggle Navigation Menu" />

    <div class="sidebar">
        <NavMenu/>
    </div>

    <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>

    <main>
        <div class="top-row px-4">
            <label for="nav-toggle" class="nav-toggle-btn" title="Toggle navigation menu" aria-label="Toggle navigation menu">
                <span class="nav-toggle-icon"></span>
            </label>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>