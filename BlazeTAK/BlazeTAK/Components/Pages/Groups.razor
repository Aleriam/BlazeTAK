        }
    }

    private async Task CancelJoinRequestAsync()
    {
        if (currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(currentUser.ID);
            if (userInDb != null)
            {
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                successMessage = "Join request cancelled.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to cancel join request: {ex.Message}";
        }
    }

    private async Task LeaveCurrentUnitAsync()
    {
        if (currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(currentUser.ID);
            if (userInDb != null)
            {
                var ledUnit = await DbContext.Units.FirstOrDefaultAsync(u => u.LeaderId == userInDb.ID);
                if (ledUnit != null)
                {
                    ledUnit.LeaderId = null;
                }

                userInDb.UnitId = null;
                userInDb.GroupId = null;
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                successMessage = "You have left the group/unit.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to leave unit: {ex.Message}";
        }
    }

