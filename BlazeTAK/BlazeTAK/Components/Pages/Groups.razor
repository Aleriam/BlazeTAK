@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using BlazeTAK.Data
@using BlazeTAK.Data.Models
@using BlazeTAK.Services
@using BlazeTAK.Client.Models
@using System.Linq

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Identity.RoleManager<Microsoft.AspNetCore.Identity.IdentityRole> RoleManager

<PageTitle>Groups Management</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-diagram-3"></i> Group & Unit Management</h2>
        @if (_currentUser != null)
        {
            <div>
                <span class="badge bg-secondary me-2">CallSign: @(string.IsNullOrEmpty(_currentUser.CallSign) ? "None" : $"{_currentUser.CallSign}-{_currentUser.CallSignNumber}")</span>
                @if (_canManage)
                {
                    <span class="badge bg-primary"><i class="bi bi-shield-lock-fill"></i> Manager (EditGroupData: Enabled)</span>
                }
                else
                {
                    <span class="badge bg-info text-dark">Member</span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading data...</p>
        </div>
    }
    else if (_currentUser == null)
    {
        <div class="alert alert-warning">
            User profile not found.
        </div>
    }
    else
    {
        @* CallSign and Profile Settings Card (Available to users) *@
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-person-badge"></i> My Profile & Callsign Settings</h5>
                @if (_currentUser.Unit != null)
                {
                    <span class="badge bg-success">
                        Unit: @_currentUser.Unit.Name @(_currentUser.Unit.Group != null ? $"({_currentUser.Unit.Group.Name})" : (_currentUser.Group != null ? $"({_currentUser.Group.Name})" : ""))
                    </span>
                }
                else if (_currentUser.Group != null)
                {
                    <span class="badge bg-success">
                        Group: @_currentUser.Group.Name (No Unit Assigned)
                    </span>
                }
                else if (_currentUser.RequestedGroup != null)
                {
                    <span class="badge bg-warning text-dark">
                        Pending request for group: @_currentUser.RequestedGroup.Name
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">No Group Assigned</span>
                }
            </div>
            <div class="card-body">
                <EditForm Model="_callSignModel" OnValidSubmit="SaveCallSignSettingsAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">CallSign</label>
                            <InputText class="form-control" @bind-Value="_callSignModel.CallSign" placeholder="e.g. ALPHA, VIPER" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CallSign Number</label>
                            <InputNumber class="form-control" @bind-Value="_callSignModel.CallSignNumber" min="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Display Name</label>
                            <InputText class="form-control" @bind-Value="_callSignModel.Name" placeholder="Your name" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-save"></i> Save Callsign
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        @if (_canManage)
        {
            @* MANAGER VIEW: CAN CREATE GROUPS, UNITS, ASSIGN USERS, ACCEPT JOIN REQUESTS *@
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Create New Group</h5>
                        </div>
                        <div class="card-body">
                            <EditForm Model="_newGroupModel" OnValidSubmit="CreateGroupAsync">
                                <DataAnnotationsValidator />
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label">Group Name *</label>
                                        <InputText class="form-control" @bind-Value="_newGroupModel.Name" placeholder="e.g. 1st Battalion" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">CallSign</label>
                                        <InputText class="form-control" @bind-Value="_newGroupModel.CallSign" placeholder="e.g. BATTALION" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">CallSign Number</label>
                                        <InputNumber class="form-control" @bind-Value="_newGroupModel.CallSignNumber" min="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="bi bi-folder-plus"></i> Create Group
                                        </button>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>

            @* PENDING JOIN REQUESTS ACROSS GROUPS *@
            @if (_pendingUsers.Any())
            {
                <div class="card mb-4 border-warning shadow-sm">
                    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-plus-fill"></i> Users Opted to Join Groups (@_pendingUsers.Count)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>User Name</th>
                                        <th>CallSign</th>
                                        <th>Requested Group</th>
                                        <th>Assign to Unit</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in _pendingUsers)
                                    {
                                        var targetGroup = _groups.FirstOrDefault(g => g.ID == user.RequestedGroupId);
                                        var groupUnits = targetGroup?.Units ?? new List<Unit>();
                                        <tr>
                                            <td>
                                                <strong>@(string.IsNullOrEmpty(user.Name) ? user.ApplicationUser?.UserName : user.Name)</strong>
                                                <div class="small text-muted">@user.ApplicationUser?.Email</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@(string.IsNullOrEmpty(user.CallSign) ? "-" : $"{user.CallSign}-{user.CallSignNumber}")</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@(targetGroup?.Name ?? "Unknown Group")</span>
                                            </td>
                                            <td style="min-width: 200px;">
                                                @if (groupUnits.Any())
                                                {
                                                    <select class="form-select form-select-sm" @bind="_selectedAcceptUnitIds[user.ID]">
                                                        <option value="">-- Select Unit (or Accept to Group) --</option>
                                                        @foreach (var u in groupUnits)
                                                        {
                                                            <option value="@u.ID">@u.Name (@u.CallSign-@u.CallSignNumber)</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No units in group yet</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-success" @onclick="() => AcceptUserRequestAsync(user)">
                                                        <i class="bi bi-check-lg"></i> Accept
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => RejectUserRequestAsync(user)">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @* GROUPS LIST WITH UNIT AND USER MANAGEMENT *@
            <h4 class="mb-3"><i class="bi bi-collection"></i> Managed Groups</h4>
            @if (!_groups.Any())
            {
                <div class="alert alert-info">
                    No groups found. Create a group above to get started.
                </div>
            }
            else
            {
                @foreach (var group in _groups)
                {
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0 d-inline">@group.Name</h5>
                                <span class="badge bg-secondary ms-2">CallSign: @group.CallSign-@group.CallSignNumber</span>
                                <span class="badge bg-info text-dark ms-1">@group.Units.Count Units</span>
                                @if (group.Leader != null)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Group Leader (sends on behalf of group)"><i class="bi bi-star-fill"></i> Leader: @group.Leader.CallSign-@group.Leader.CallSignNumber</span>
                                }
                                @if (_canManage)
                                {
                                    <select class="form-select form-select-sm d-inline-block w-auto" @bind="_leaderAppointIds[group.ID]">
                                        <option value="">-- none --</option>
                                        @foreach (var member in group.Units.SelectMany(u => u.Users).DistinctBy(u => u.ID))
                                        {
                                            <option value="@member.ID">@member.Name [@member.CallSign-@member.CallSignNumber]</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-sm btn-warning" title="Appoint group leader" @onclick="() => AppointGroupLeaderAsync(group.ID)">★</button>
                                }
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-light me-1" @onclick="() => ToggleCreateUnitForm(group.ID)">
                                    <i class="bi bi-plus-lg"></i> @(_showCreateUnitForGroup == group.ID ? "Cancel" : "Add Unit")
                                </button>
                                <button class="btn btn-sm btn-outline-light" @onclick="() => ToggleAssignUserForm(group.ID)">
                                    <i class="bi bi-person-plus"></i> @(_showAssignUserForGroup == group.ID ? "Cancel" : "Assign User")
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            @* Inline Add Unit Form *@
                            @if (_showCreateUnitForGroup == group.ID)
                            {
                                <div class="card card-body mb-3 border-primary">
                                    <h6 class="card-title text-primary"><i class="bi bi-plus-circle"></i> Add Unit to @group.Name</h6>
                                    <EditForm Model="_newUnitModel" OnValidSubmit="() => CreateUnitAsync(group.ID)">
                                        <DataAnnotationsValidator />
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label small">Unit Name *</label>
                                                <InputText class="form-control form-control-sm" @bind-Value="_newUnitModel.Name" placeholder="e.g. Squad 1" required />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">CallSign</label>
                                                <InputText class="form-control form-control-sm" @bind-Value="_newUnitModel.CallSign" placeholder="e.g. SQUAD1" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">CallSign #</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="_newUnitModel.CallSignNumber" min="0" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">Marker Radius (m)</label>
                                                <InputNumber class="form-control form-control-sm" @bind-Value="_newUnitModel.MarkerRaduis" min="0" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Marker Type (SIDC)</label>
                                                <select class="form-select form-select-sm font-monospace" @bind="_newUnitModel.UnitType">
                                                    @foreach (var cat in _markerCategories)
                                                    {
                                                        <optgroup label="@cat.Name">
                                                            @foreach (var sym in cat.Symbols)
                                                            {
                                                                <option value="@sym.Sidc">@sym.Name (@sym.Sidc)</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12 mt-2">
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-check-circle"></i> Save Unit
                                                </button>
                                            </div>
                                        </div>
                                    </EditForm>
                                </div>
                            }

                            @* Inline Assign User to Unit Form *@
                            @if (_showAssignUserForGroup == group.ID)
                            {
                                <div class="card card-body mb-3 border-success">
                                    <h6 class="card-title text-success"><i class="bi bi-person-check"></i> Assign User to Unit in @group.Name</h6>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-5">
                                            <label class="form-label small">Select User</label>
                                            <select class="form-select form-select-sm" @bind="_assignUserId">
                                                <option value="">-- Choose User --</option>
                                                @foreach (var u in _allUsers)
                                                {
                                                    var currentInfo = u.Unit != null ? $" (Currently in: {u.Unit.Name})" : " (Unassigned)";
                                                    <option value="@u.ID">@u.Name [@u.CallSign-@u.CallSignNumber]@currentInfo</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Select Target Unit</label>
                                            <select class="form-select form-select-sm" @bind="_assignUnitId">
                                                <option value="">-- Choose Unit --</option>
                                                @foreach (var u in group.Units)
                                                {
                                                    <option value="@u.ID">@u.Name (@u.CallSign-@u.CallSignNumber)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success flex-grow-1" @onclick="() => AssignUserToUnitAsync(_assignUserId, _assignUnitId)">
                                                    <i class="bi bi-check-lg"></i> Assign
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleAssignUserForm(group.ID)">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* UNITS IN THIS GROUP *@
                            @if (!group.Units.Any())
                            {
                                <p class="text-muted fst-italic mb-0">No units in this group yet. Click "Add Unit" to create one.</p>
                            }
                            else
                            {
                                <div class="row row-cols-1 row-cols-md-2 g-3">
                                    @foreach (var unit in group.Units)
                                    {
                                        <div class="col">
                                            <div class="card h-100 border">
                                                <div class="card-header d-flex justify-content-between align-items-center py-2">
                                                    <div>
                                                        <strong>@unit.Name</strong>
                                                        <span class="badge bg-secondary ms-1">@unit.CallSign-@unit.CallSignNumber</span>
                                                        <span class="badge bg-primary ms-1 font-monospace" title="Unit Marker SIDC">@(!string.IsNullOrEmpty(unit.UnitType) ? unit.UnitType : "SFGPUCI----")</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <span class="badge bg-info text-dark">Radius: @(unit.MarkerRaduis)m</span>
                                                        @if (_canManage)
                                                        {
                                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" title="Edit Unit Settings" @onclick="() => StartEditUnit(unit)">
                                                                <i class="bi bi-gear-fill"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="card-body p-2">
                                                    @if (_editingUnitId == unit.ID)
                                                    {
                                                        <div class="p-2 mb-2 bg-light rounded border border-warning">
                                                            <h6 class="small fw-bold text-dark mb-2"><i class="bi bi-gear"></i> Edit Unit Settings</h6>
                                                            <EditForm Model="_editUnitModel" OnValidSubmit="SaveEditUnitAsync">
                                                                <DataAnnotationsValidator />
                                                                <div class="row g-2 align-items-end">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small">Unit Name</label>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="_editUnitModel.Name" required />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">CallSign</label>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="_editUnitModel.CallSign" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label small">CallSign #</label>
                                                                        <InputNumber class="form-control form-control-sm" @bind-Value="_editUnitModel.CallSignNumber" min="0" />
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <label class="form-label small">Marker Radius (m)</label>
                                                                        <InputNumber class="form-control form-control-sm" @bind-Value="_editUnitModel.MarkerRaduis" min="0" />
                                                                    </div>
                                                                    <div class="col-md-8">
                                                                        <label class="form-label small">Marker Type (SIDC)</label>
                                                                        <select class="form-select form-select-sm font-monospace" @bind="_editUnitModel.UnitType">
                                                                            @foreach (var cat in _markerCategories)
                                                                            {
                                                                                <optgroup label="@cat.Name">
                                                                                    @foreach (var sym in cat.Symbols)
                                                                                    {
                                                                                        <option value="@sym.Sidc">@sym.Name (@sym.Sidc)</option>
                                                                                    }
                                                                                </optgroup>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12 mt-2 d-flex gap-2">
                                                                        <button type="submit" class="btn btn-sm btn-success">
                                                                            <i class="bi bi-check-lg"></i> Save Changes
                                                                        </button>
                                                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEditUnit">
                                                                            Cancel
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </EditForm>
                                                        </div>
                                                    }

                                                    <div class="small mb-2">
                                                        <strong>Leader:</strong>
                                                        @if (unit.Leader != null)
                                                        {
                                                            <span class="text-primary font-monospace">@unit.Leader.Name (@unit.Leader.CallSign-@unit.Leader.CallSignNumber)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">None</span>
                                                        }
                                                    </div>

                                                    <h6 class="small text-muted mb-1">Assigned Users (@unit.Users.Count):</h6>
                                                    @if (!unit.Users.Any())
                                                    {
                                                        <p class="small text-muted mb-2">No users assigned.</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="list-group list-group-flush small mb-2">
                                                            @foreach (var member in unit.Users)
                                                            {
                                                                <li class="list-group-item d-flex justify-content-between align-items-center px-1 py-1">
                                                                    <div>
                                                                        <span>@member.Name</span>
                                                                        <span class="badge bg-secondary ms-1">@member.CallSign-@member.CallSignNumber</span>
                                                                        @if (unit.LeaderId == member.ID)
                                                                        {
                                                                            <span class="badge bg-warning text-dark ms-1">Leader</span>
                                                                        }
                                                                    </div>
                                                                    <div class="btn-group btn-group-sm">
                                                                        @if (unit.LeaderId != member.ID)
                                                                        {
                                                                            <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Set as Leader" @onclick="() => SetUnitLeaderAsync(unit, member.ID)">
                                                                                <i class="bi bi-star"></i>
                                                                            </button>
                                                                        }
                                                                        <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Remove from Unit" @onclick="() => RemoveUserFromUnitAsync(member)">
                                                                            <i class="bi bi-person-x"></i>
                                                                        </button>
                                                                    </div>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            @* STANDARD USER VIEW: CAN SEE ALL AVAILABLE GROUPS AND OPT TO JOIN ONE *@
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-grid-3x3-gap"></i> Available Groups</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Browse the available groups below and opt to join one. A group manager will review your request.</p>

                    @if (!_groups.Any())
                    {
                        <div class="alert alert-info">
                            No groups are currently available.
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-4">
                            @foreach (var group in _groups)
                            {
                                var isCurrentGroup = _currentUser.GroupId == group.ID || _currentUser.Unit?.GroupId == group.ID;
                                var isRequestedGroup = _currentUser.RequestedGroupId == group.ID;

                                <div class="col">
                                    <div class="card h-100 shadow-sm @(isCurrentGroup ? "border-success" : isRequestedGroup ? "border-warning" : "")">
                                        <div class="card-header d-flex justify-content-between align-items-center @(isCurrentGroup ? "bg-success text-white" : isRequestedGroup ? "bg-warning text-dark" : "")">
                                            <div>
                                                <h5 class="mb-0 d-inline">@group.Name</h5>
                                                <span class="badge @(isCurrentGroup ? "bg-secondary text-white" : "bg-secondary") ms-2">
                                                    @group.CallSign-@group.CallSignNumber
                                                </span>
                                            </div>
                                            @if (isCurrentGroup)
                                            {
                                                <span class="badge bg-secondary text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Joined</span>
                                            }
                                            else if (isRequestedGroup)
                                            {
                                                <span class="badge bg-dark text-warning fw-bold"><i class="bi bi-hourglass-split"></i> Pending Request</span>
                                            }
                                        </div>
                                        <div class="card-body">
                                            <h6 class="text-muted mb-2">Units in Group (@group.Units.Count):</h6>
                                            @if (!group.Units.Any())
                                            {
                                                <p class="small text-muted">No units in this group yet.</p>
                                            }
                                            else
                                            {
                                                <ul class="list-group list-group-flush mb-3">
                                                    @foreach (var unit in group.Units)
                                                    {
                                                        var isUserUnit = _currentUser.UnitId == unit.ID;
                                                        <li class="list-group-item d-flex justify-content-between align-items-center px-2 py-1 @(isUserUnit ? "fw-bold" : "")">
                                                            <span>
                                                                <i class="bi bi-shield me-1"></i> @unit.Name (@unit.CallSign-@unit.CallSignNumber)
                                                            </span>
                                                            <span class="badge bg-secondary rounded-pill">@unit.Users.Count members</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }

                                            <div class="mt-3">
                                                @if (isCurrentGroup)
                                                {
                                                    @if (_currentUser.Unit != null && _currentUser.Unit.GroupId == group.ID)
                                                    {
                                                        <div class="text-success small fw-bold mb-2">
                                                            <i class="bi bi-check-lg"></i> You are currently a member of unit: @(_currentUser.Unit.Name)
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-success small fw-bold mb-2">
                                                            <i class="bi bi-check-lg"></i> You are a member of this group (Unassigned Unit)
                                                        </div>
                                                    }
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="LeaveCurrentUnitAsync">
                                                        <i class="bi bi-box-arrow-right"></i> Leave Group
                                                    </button>
                                                }
                                                else if (isRequestedGroup)
                                                {
                                                    <button class="btn btn-warning btn-sm" @onclick="CancelJoinRequestAsync">
                                                        <i class="bi bi-x-circle"></i> Cancel Join Request
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => OptToJoinGroupAsync(group.ID)">
                                                        <i class="bi bi-box-arrow-in-right"></i> Opt to Join
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private User? _currentUser;
    //admin (role 'admin') always bypasses the EditGroupData verification
    private bool _canManage;
    private List<Group> _groups = new();
    private List<User> _allUsers = new();
    private List<User> _pendingUsers = new();
    private List<MarkerCategory> _markerCategories = MarkerSymbolDefinitions.GetCategories();

    private string? _successMessage;
    private string? _errorMessage;

    // View toggles
    private Guid? _showCreateUnitForGroup;
    private Guid? _showAssignUserForGroup;
    private Guid? _editingUnitId;

    // Forms and inputs
    private CallSignFormModel _callSignModel = new();
    private GroupFormModel _newGroupModel = new();
    private UnitFormModel _newUnitModel = new();
    private UnitFormModel _editUnitModel = new();

    private Guid? _assignUserId;
    private Guid? _assignUnitId;
    private Dictionary<Guid, Guid?> _selectedAcceptUnitIds = new();
    private Dictionary<Guid, Guid?> _leaderAppointIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            var userId = claimsPrincipal.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrEmpty(userId))
            {
                _isLoading = false;
                return;
            }

            // Load current user profile
            _currentUser = await DbContext.Profiles
                .Include(u => u.Group)
                .Include(u => u.Unit)
                    .ThenInclude(un => un!.Group)
                .Include(u => u.RequestedGroup)
                .FirstOrDefaultAsync(u => u.ApplicationUserId == userId);

            _canManage = claimsPrincipal.IsInRole(AppRoles.Admin) || (_currentUser?.EditGroupData ?? false);

            if (_currentUser != null)
            {
                _callSignModel.CallSign = _currentUser.CallSign;
                _callSignModel.CallSignNumber = _currentUser.CallSignNumber;
                _callSignModel.Name = _currentUser.Name;
            }

            // Load groups with units and their users
            _groups = await DbContext.Groups
                .Include(g => g.Leader)
                .Include(g => g.Units)
                    .ThenInclude(u => u.Users)
                .Include(g => g.Units)
                    .ThenInclude(u => u.Leader)
                .OrderBy(g => g.Name)
                .ToListAsync();

            // leader select must have an entry for every group before first render
            // (bind on dictionary indexer throws KeyNotFoundException otherwise)
            foreach (var group in _groups)
            {
                if (!_leaderAppointIds.ContainsKey(group.ID))
                    _leaderAppointIds[group.ID] = group.LeaderId;
            }

            // Load all users for assignment
            _allUsers = await DbContext.Profiles
                .Include(u => u.Group)
                .Include(u => u.Unit)
                .Include(u => u.ApplicationUser)
                .OrderBy(u => u.Name)
                .ToListAsync();

            // Load pending requests
            _pendingUsers = await DbContext.Profiles
                .Include(u => u.RequestedGroup)
                .Include(u => u.ApplicationUser)
                .Where(u => u.RequestedGroupId != null)
                .ToListAsync();

            foreach (var user in _pendingUsers)
            {
                if (!_selectedAcceptUnitIds.ContainsKey(user.ID))
                {
                    _selectedAcceptUnitIds[user.ID] = null;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveCallSignSettingsAsync()
    {
        if (_currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(_currentUser.ID);
            if (userInDb != null)
            {
                userInDb.CallSign = _callSignModel.CallSign?.Trim() ?? string.Empty;
                userInDb.CallSignNumber = _callSignModel.CallSignNumber;
                userInDb.Name = _callSignModel.Name?.Trim() ?? string.Empty;

                await DbContext.SaveChangesAsync();
                _successMessage = "Callsign and profile updated successfully!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update callsign: {ex.Message}";
        }
    }

    private async Task CreateGroupAsync()
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var group = new Group
            {
                ID = Guid.NewGuid(),
                Name = _newGroupModel.Name.Trim(),
                CallSign = _newGroupModel.CallSign?.Trim() ?? string.Empty,
                CallSignNumber = _newGroupModel.CallSignNumber
            };

            DbContext.Groups.Add(group);
            await DbContext.SaveChangesAsync();

            _newGroupModel = new();
            _successMessage = $"Group '{group.Name}' created successfully!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create group: {ex.Message}";
        }
    }

    private async Task AppointGroupLeaderAsync(Guid groupId)
    {
        if (_currentUser == null || !_canManage) return;
        if (!_leaderAppointIds.TryGetValue(groupId, out var userId)) return;

        //clearing the selection removes leadership
        if (userId == null || userId == Guid.Empty)
        {
            await ClearGroupLeaderAsync(groupId);
            return;
        }

        try
        {
            var user = await DbContext.Profiles
                .Include(p => p.LeadingGroup)
                .FirstOrDefaultAsync(p => p.ID == userId);
            var group = await DbContext.Groups.Include(g => g.Leader).FirstOrDefaultAsync(g => g.ID == groupId);
            if (user == null || group == null) return;

            //demote previous leader
            if (group.Leader != null)
            {
                var previousLeader = group.Leader;
                previousLeader.LeadingGroup = null;
                DbContext.Profiles.Update(previousLeader);

                var previousLeaderAppUser = await UserManager.FindByIdAsync(previousLeader.ApplicationUserId);
                //keep role if he still leads another group or any unit
                bool stillLeader = await DbContext.Groups.AnyAsync(g => g.LeaderId == previousLeader.ID && g.ID != groupId)
                    || await DbContext.Units.AnyAsync(u => u.LeaderId == previousLeader.ID);
                if (!stillLeader && previousLeaderAppUser != null
                    && !await UserManager.IsInRoleAsync(previousLeaderAppUser, AppRoles.Admin))
                {
                    await UserManager.RemoveFromRoleAsync(previousLeaderAppUser, AppRoles.GroupLeader);
                }
            }

            group.LeaderId = user.ID;
            user.LeadingGroup = group;
            DbContext.Groups.Update(group);
            DbContext.Profiles.Update(user);
            await DbContext.SaveChangesAsync();

            //sync identity role
            var appUser = await UserManager.FindByIdAsync(user.ApplicationUserId);
            if (appUser != null && !await UserManager.IsInRoleAsync(appUser, AppRoles.GroupLeader))
                await UserManager.AddToRoleAsync(appUser, AppRoles.GroupLeader);

            _successMessage = $"{user.Name} appointed as leader of '{group.Name}'.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to appoint group leader: {ex.Message}";
        }
    }

    private async Task ClearGroupLeaderAsync(Guid groupId)
    {
        try
        {
            var group = await DbContext.Groups.Include(g => g.Leader).FirstOrDefaultAsync(g => g.ID == groupId);
            if (group?.Leader == null) return;

            var previousLeader = group.Leader;
            previousLeader.LeadingGroup = null;
            DbContext.Profiles.Update(previousLeader);
            group.LeaderId = null;
            await DbContext.SaveChangesAsync();

            //keep the role if he still leads another group or any unit
            var previousLeaderAppUser = await UserManager.FindByIdAsync(previousLeader.ApplicationUserId);
            var stillLeader = await DbContext.Groups.AnyAsync(g => g.LeaderId == previousLeader.ID)
                || await DbContext.Units.AnyAsync(u => u.LeaderId == previousLeader.ID);
            if (!stillLeader && previousLeaderAppUser != null
                && !await UserManager.IsInRoleAsync(previousLeaderAppUser, AppRoles.Admin))
            {
                await UserManager.RemoveFromRoleAsync(previousLeaderAppUser, AppRoles.GroupLeader);
            }

            _successMessage = $"Leadership of '{group.Name}' cleared.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to clear group leader: {ex.Message}";
        }
    }

    private void ToggleCreateUnitForm(Guid groupId)
    {
        if (_showCreateUnitForGroup == groupId)
        {
            _showCreateUnitForGroup = null;
        }
        else
        {
            _showCreateUnitForGroup = groupId;
            _newUnitModel = new();
        }
    }

    private async Task CreateUnitAsync(Guid groupId)
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var unit = new Unit
            {
                ID = Guid.NewGuid(),
                GroupId = groupId,
                Name = _newUnitModel.Name.Trim(),
                CallSign = _newUnitModel.CallSign?.Trim() ?? string.Empty,
                CallSignNumber = _newUnitModel.CallSignNumber,
                MarkerRaduis = _newUnitModel.MarkerRaduis,
                UnitType = string.IsNullOrWhiteSpace(_newUnitModel.UnitType) ? "SFGPUCI----" : _newUnitModel.UnitType.Trim()
            };

            DbContext.Units.Add(unit);
            await DbContext.SaveChangesAsync();

            _showCreateUnitForGroup = null;
            _newUnitModel = new();
            _successMessage = $"Unit '{unit.Name}' created successfully!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create unit: {ex.Message}";
        }
    }

    private void StartEditUnit(Unit unit)
    {
        _editingUnitId = unit.ID;
        _editUnitModel = new UnitFormModel
        {
            Id = unit.ID,
            Name = unit.Name,
            CallSign = unit.CallSign,
            CallSignNumber = unit.CallSignNumber,
            MarkerRaduis = unit.MarkerRaduis,
            UnitType = string.IsNullOrWhiteSpace(unit.UnitType) ? "SFGPUCI----" : unit.UnitType
        };
    }

    private void CancelEditUnit()
    {
        _editingUnitId = null;
    }

    private async Task SaveEditUnitAsync()
    {
        if (_currentUser == null || !_canManage) return;
        if (_editUnitModel.Id == null) return;

        try
        {
            var unitInDb = await DbContext.Units.FindAsync(_editUnitModel.Id.Value);
            if (unitInDb != null)
            {
                unitInDb.Name = _editUnitModel.Name.Trim();
                unitInDb.CallSign = _editUnitModel.CallSign?.Trim() ?? string.Empty;
                unitInDb.CallSignNumber = _editUnitModel.CallSignNumber;
                unitInDb.MarkerRaduis = _editUnitModel.MarkerRaduis;
                unitInDb.UnitType = string.IsNullOrWhiteSpace(_editUnitModel.UnitType) ? "SFGPUCI----" : _editUnitModel.UnitType.Trim();

                await DbContext.SaveChangesAsync();
                _editingUnitId = null;
                _successMessage = $"Unit '{unitInDb.Name}' settings updated successfully!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update unit: {ex.Message}";
        }
    }

    private void ToggleAssignUserForm(Guid groupId)
    {
        if (_showAssignUserForGroup == groupId)
        {
            _showAssignUserForGroup = null;
        }
        else
        {
            _showAssignUserForGroup = groupId;
            _assignUserId = null;
            _assignUnitId = null;
        }
    }

    private async Task AssignUserToUnitAsync(Guid? userId, Guid? unitId)
    {
        if (_currentUser == null || !_canManage) return;
        if (userId == null || unitId == null)
        {
            _errorMessage = "Please select both a user and a target unit.";
            return;
        }

        try
        {
            var user = await DbContext.Profiles.FindAsync(userId.Value);
            var unit = await DbContext.Units.FindAsync(unitId.Value);

            if (user != null && unit != null)
            {
                user.GroupId = unit.GroupId;
                user.UnitId = unit.ID;
                user.RequestedGroupId = null; // Clear any pending join request

                await DbContext.SaveChangesAsync();
                _showAssignUserForGroup = null;
                _successMessage = $"User '{user.Name}' assigned to unit '{unit.Name}'!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to assign user: {ex.Message}";
        }
    }

    private async Task SetUnitLeaderAsync(Unit unit, Guid leaderId)
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var unitInDb = await DbContext.Units.FindAsync(unit.ID);
            if (unitInDb != null)
            {
                unitInDb.LeaderId = leaderId;
                await DbContext.SaveChangesAsync();
                _successMessage = $"Unit leader updated!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to set unit leader: {ex.Message}";
        }
    }

    private async Task RemoveUserFromUnitAsync(User user)
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb != null)
            {
                // If user was unit leader, clear leader
                var ledUnit = await DbContext.Units.FirstOrDefaultAsync(u => u.LeaderId == user.ID);
                if (ledUnit != null)
                {
                    ledUnit.LeaderId = null;
                }

                userInDb.UnitId = null;
                await DbContext.SaveChangesAsync();
                _successMessage = $"User '{userInDb.Name}' removed from unit.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to remove user: {ex.Message}";
        }
    }

    private async Task AcceptUserRequestAsync(User user)
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb == null) return;
            if (userInDb.RequestedGroupId == null) return;

            var targetGroupId = userInDb.RequestedGroupId;
            userInDb.GroupId = targetGroupId;

            if (_selectedAcceptUnitIds.TryGetValue(user.ID, out var unitId) && unitId.HasValue)
            {
                userInDb.UnitId = unitId.Value;
            }

            userInDb.RequestedGroupId = null;
            _selectedAcceptUnitIds.Remove(user.ID);

            await DbContext.SaveChangesAsync();
            _successMessage = $"Request from '{(string.IsNullOrEmpty(userInDb.Name) ? userInDb.ApplicationUserId : userInDb.Name)}' accepted.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to accept request: {ex.Message}";
        }
    }

    private async Task RejectUserRequestAsync(User user)
    {
        if (_currentUser == null || !_canManage) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb != null)
            {
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                _successMessage = $"Request from '{userInDb.Name}' rejected.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to reject request: {ex.Message}";
        }
    }

    private async Task OptToJoinGroupAsync(Guid groupId)
    {
        if (_currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(_currentUser.ID);
            if (userInDb != null)
            {
                userInDb.RequestedGroupId = groupId;
                await DbContext.SaveChangesAsync();
                _successMessage = "Join request submitted! A group manager will review your request.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to submit join request: {ex.Message}";
        }
    }

    private async Task CancelJoinRequestAsync()
    {
        if (_currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(_currentUser.ID);
            if (userInDb != null)
            {
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                _successMessage = "Join request cancelled.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to cancel join request: {ex.Message}";
        }
    }

    private async Task LeaveCurrentUnitAsync()
    {
        if (_currentUser == null) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(_currentUser.ID);
            if (userInDb != null)
            {
                var ledUnit = await DbContext.Units.FirstOrDefaultAsync(u => u.LeaderId == userInDb.ID);
                if (ledUnit != null)
                {
                    ledUnit.LeaderId = null;
                }

                userInDb.UnitId = null;
                userInDb.GroupId = null;
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                _successMessage = "You have left the group/unit.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to leave unit: {ex.Message}";
        }
    }

