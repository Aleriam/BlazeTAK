    private async Task AssignUserToUnitAsync(Guid? userId, Guid? unitId)
    {
        if (currentUser == null || !currentUser.EditGroupData) return;
        if (userId == null || unitId == null)
        {
            errorMessage = "Please select both a user and a target unit.";
            return;
        }

        try
        {
            var user = await DbContext.Profiles.FindAsync(userId.Value);
            var unit = await DbContext.Units.FindAsync(unitId.Value);

            if (user != null && unit != null)
            {
                user.GroupId = unit.GroupId;
                user.UnitId = unit.ID;
                user.RequestedGroupId = null; // Clear any pending join request

                await DbContext.SaveChangesAsync();
                showAssignUserForGroup = null;
                successMessage = $"User '{user.Name}' assigned to unit '{unit.Name}'!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to assign user: {ex.Message}";
        }
    }

    private async Task SetUnitLeaderAsync(Unit unit, Guid leaderId)
    {
        if (currentUser == null || !currentUser.EditGroupData) return;

        try
        {
            var unitInDb = await DbContext.Units.FindAsync(unit.ID);
            if (unitInDb != null)
            {
                unitInDb.LeaderId = leaderId;
                await DbContext.SaveChangesAsync();
                successMessage = $"Unit leader updated!";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to set unit leader: {ex.Message}";
        }
    }

    private async Task RemoveUserFromUnitAsync(User user)
    {
        if (currentUser == null || !currentUser.EditGroupData) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb != null)
            {
                // If user was unit leader, clear leader
                var ledUnit = await DbContext.Units.FirstOrDefaultAsync(u => u.LeaderId == user.ID);
                if (ledUnit != null)
                {
                    ledUnit.LeaderId = null;
                }

                userInDb.UnitId = null;
                await DbContext.SaveChangesAsync();
                successMessage = $"User '{userInDb.Name}' removed from unit.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove user: {ex.Message}";
        }
    }

    private async Task AcceptUserRequestAsync(User user)
    {
        if (currentUser == null || !currentUser.EditGroupData) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb == null) return;
            if (userInDb.RequestedGroupId == null) return;

            var targetGroupId = userInDb.RequestedGroupId;
            userInDb.GroupId = targetGroupId;

            if (selectedAcceptUnitIds.TryGetValue(user.ID, out var unitId) && unitId.HasValue)
            {
                userInDb.UnitId = unitId.Value;
            }

            userInDb.RequestedGroupId = null;
            selectedAcceptUnitIds.Remove(user.ID);

            await DbContext.SaveChangesAsync();
            successMessage = $"Request from '{(string.IsNullOrEmpty(userInDb.Name) ? userInDb.ApplicationUserId : userInDb.Name)}' accepted.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to accept request: {ex.Message}";
        }
    }

    private async Task RejectUserRequestAsync(User user)
    {
        if (currentUser == null || !currentUser.EditGroupData) return;

        try
        {
            var userInDb = await DbContext.Profiles.FindAsync(user.ID);
            if (userInDb != null)
            {
                userInDb.RequestedGroupId = null;
                await DbContext.SaveChangesAsync();
                successMessage = $"Request from '{userInDb.Name}' rejected.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to reject request: {ex.Message}";
        }
    }

    private async Task OptToJoinGroupAsync(Guid groupId)
    {
        if (currentUser == null) return;

