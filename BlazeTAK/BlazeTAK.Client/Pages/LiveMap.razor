    private async Task ToggleGeolocationTracking()
    {
        if (isGpsTracking)
        {
            await StopGeolocationAsync();
        }
        else
        {
            await StartGeolocationAsync();
        }
    }

    private async Task StartGeolocationAsync()
    {
        if (!mapInitialized) return;
        isGpsTracking = true;
        gpsStatusMessage = "Starting GPS tracking...";
        try
        {
            var started = await JSRuntime.InvokeAsync<bool>("liveMap.startGeolocationTracking", mapId, dotNetRef);
            if (!started)
            {
                isGpsTracking = false;
                gpsStatusMessage = "Geolocation not supported or denied by browser.";
            }
            else
            {
                gpsStatusMessage = "GPS active. Sharing position (>10m movement).";
            }
        }
        catch (Exception ex)
        {
            isGpsTracking = false;
            gpsStatusMessage = $"GPS start failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task StopGeolocationAsync()
    {
        isGpsTracking = false;
        gpsStatusMessage = "GPS tracking stopped.";
        try
        {
            await JSRuntime.InvokeVoidAsync("liveMap.stopGeolocationTracking", mapId);
        }
        catch
        {
            // Ignore
        }
        StateHasChanged();
    }

