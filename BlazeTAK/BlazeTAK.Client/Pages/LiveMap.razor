@page "/livemap"
@rendermode InteractiveWebAssembly
@using BlazeTAK.Client.Models
@using Microsoft.AspNetCore.SignalR.Client
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>LiveMap - Tactical Map View</PageTitle>

<div class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden livemap-container" style="z-index: 0;">
    <!-- Leaflet Map Container (Fills the page as background) -->
    <div id="@mapId" class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 1;"></div>

    <!-- Floating Top-Left Controls: Nav Toggle Button & Status Overlay -->
    <div class="position-absolute top-0 start-0 m-3 d-flex align-items-center gap-2" style="z-index: 1000;">
        <label for="nav-toggle" class="nav-toggle-btn shadow" title="Toggle navigation menu" aria-label="Toggle navigation menu">
            <span class="nav-toggle-icon"></span>
        </label>
        <label for="nav-toggle" class="d-flex align-items-center gap-2 px-3 py-1 rounded shadow livemap-status-bar" style="height: 2.5rem;" title="Toggle navigation menu">
            <span class="fw-bold small text-uppercase" style="color: var(--front);"><i class="bi bi-geo-alt-fill me-1"></i>LiveMap</span>
            @if (hubConnection?.State == HubConnectionState.Connected)
            {
                <span class="badge badge-highlight"><i class="bi bi-broadcast"></i> Synced (@markers.Count)</span>
            }
            else
            {
                <span class="badge badge-theme"><i class="bi bi-arrow-repeat"></i> Connecting...</span>
            }
            <span class="badge badge-theme font-monospace ms-1">@(string.IsNullOrEmpty(currentGroupName) ? "Global Group" : currentGroupName)</span>
            @if (userLocations.Count > 0)
            {
                <span class="badge bg-info text-dark ms-1" title="Unit Members Sharing Location"><i class="bi bi-people-fill me-1"></i>@userLocations.Count Unit</span>
            }
            @if (liveUnitMarkers.Count > 0)
            {
                <span class="badge bg-primary ms-1" title="Live Unit Markers"><i class="bi bi-shield-shaded me-1"></i>@liveUnitMarkers.Count HQ/Squad</span>
            }
            @if (isGpsTracking)
            {
                <span class="badge bg-success ms-1" title="GPS Tracking Active"><i class="bi bi-compass-fill me-1"></i>GPS Active</span>
            }
        </label>
    </div>

    <!-- Placement Mode Banner (on top of map when user is placing marker) -->
    @if (isPlacementMode && selectedSymbol != null)
    {
        <div class="position-absolute top-0 start-50 translate-middle-x mt-3 shadow-lg p-2 px-4 rounded-pill d-flex align-items-center gap-3 livemap-banner-place" style="z-index: 1000; animation: fadeIn 0.2s ease-in-out;">
            <div>
                <i class="bi bi-geo-alt-fill me-1"></i>
                <strong>Placing:</strong> @selectedSymbol.Name
                <span class="badge badge-highlight ms-1 font-monospace">@selectedSymbol.Sidc</span>
                <span class="ms-2 small opacity-75">Click anywhere on map to position</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="CancelPlacementMode">
                <i class="bi bi-x-circle me-1"></i>Cancel
            </button>
        </div>
    }

    <!-- Moving Marker Banner (when user activated Move mode for a marker) -->
    @if (movingMarkerId.HasValue && markers.TryGetValue(movingMarkerId.Value, out var movingMarker))
    {
        <div class="position-absolute top-0 start-50 translate-middle-x mt-3 shadow-lg p-2 px-4 rounded-pill d-flex align-items-center gap-3 livemap-banner-move" style="z-index: 1000; animation: fadeIn 0.2s ease-in-out;">
            <div>
                <i class="bi bi-arrows-move me-1"></i>
                <strong>Move Mode Active:</strong> Drag <strong>@movingMarker.Name</strong> on the map to reposition.
            </div>
            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" @onclick="EndMoveMode">
                <i class="bi bi-check-circle me-1"></i>Done Moving
            </button>
        </div>
    }

    <!-- Right-Click Context Menu for Marker (Options: Move, Edit, Delete) -->
    @if (showContextMenu && contextMarker != null)
    {
        <!-- Backdrop to close context menu when clicking outside -->
        <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 1200; background: transparent;" @onclick="CloseContextMenu" @oncontextmenu:preventDefault @oncontextmenu="CloseContextMenu"></div>

        <div class="position-absolute shadow-lg rounded context-menu-box py-1"
             style="z-index: 1201; left: @(contextMenuX)px; top: @(contextMenuY)px; min-width: 170px; animation: fadeIn 0.15s ease-in-out;">
            <div class="px-3 py-1 small fw-bold text-truncate border-bottom opacity-75">
                <i class="bi bi-pin-map-fill me-1"></i>@contextMarker.Name
            </div>
            <button type="button" class="dropdown-item px-3 py-2 d-flex align-items-center gap-2 small" @onclick="() => HandleContextMenuAction(MarkerAction.Move)">
                <i class="bi bi-arrows-move"></i>
                <span><strong>Move</strong> (Drag on map)</span>
            </button>
            <button type="button" class="dropdown-item px-3 py-2 d-flex align-items-center gap-2 small" @onclick="() => HandleContextMenuAction(MarkerAction.Edit)">
                <i class="bi bi-pencil-square"></i>
                <span><strong>Edit</strong> details</span>
            </button>
            <div class="dropdown-divider my-1"></div>
            <button type="button" class="dropdown-item px-3 py-2 d-flex align-items-center gap-2 small" @onclick="() => HandleContextMenuAction(MarkerAction.Delete)">
                <i class="bi bi-trash-fill"></i>
                <span><strong>Delete</strong> marker</span>
            </button>
        </div>
    }

    <!-- Tactical Map Toolbox Overlay (Floating on top-right) -->
    <div class="position-absolute top-0 end-0 m-3 shadow" style="z-index: 900; width: 320px; max-height: calc(100vh - 24px); display: flex; flex-direction: column;">
        <div class="card border shadow-sm livemap-toolbox">
            <!-- Toolbox Header -->
            <div class="card-header d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tools"></i>
                    <strong class="small text-uppercase tracking-wider">Toolbox</strong>
                </div>
                <button class="btn btn-sm btn-outline-primary py-2 px-4" @onclick="() => isToolboxExpanded = !isToolboxExpanded" title="Toggle Toolbox">
                    <i class="bi @(isToolboxExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>

            @if (isToolboxExpanded)
            {
                <div class="card-body p-2 overflow-auto" style="max-height: calc(100vh - 120px);">
                    <!-- Toolbox Action Buttons -->
                    <div class="d-grid gap-2 mb-2">
                        <button type="button" class="btn btn-sm @(isMarkerSelectorOpen ? "btn-primary" : "btn-outline-primary") text-start d-flex justify-content-between align-items-center" @onclick="ToggleMarkerSelector">
                            <span><i class="bi bi-pin-map-fill me-2"></i>Add Marker</span>
                            <i class="bi @(isMarkerSelectorOpen ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        </button>

                        <button type="button" class="btn btn-sm @(isGpsPanelOpen ? "btn-success" : "btn-outline-success") text-start d-flex justify-content-between align-items-center" @onclick="ToggleGpsPanel">
                            <span><i class="bi bi-compass-fill me-2"></i>Live Geolocation</span>
                            <i class="bi @(isGpsPanelOpen ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        </button>
                        
                        <button type="button" class="btn btn-sm @(isSettingsOpen ? "btn-secondary" : "btn-outline-secondary") text-start d-flex justify-content-between align-items-center" @onclick="ToggleSettings">
                            <span><i class="bi bi-gear-fill me-2"></i>Settings</span>
                            <i class="bi @(isSettingsOpen ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        </button>
                    </div>

                    <!-- Geolocation Tracking Panel -->
                    @if (isGpsPanelOpen)
                    {
                        <div class="p-2 mb-2 border rounded livemap-panel small">
                            <h6 class="border-bottom pb-1 mb-2 fw-bold text-success"><i class="bi bi-geo-alt-fill me-1"></i>Geolocation Sharing</h6>
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span>GPS Tracking:</span>
                                    <button type="button" class="btn btn-sm @(isGpsTracking ? "btn-danger" : "btn-success") py-1 px-2" @onclick="ToggleGeolocationTracking">
                                        <i class="bi @(isGpsTracking ? "bi-stop-fill" : "bi-play-fill") me-1"></i>@(isGpsTracking ? "Stop GPS" : "Start GPS")
                                    </button>
                                </div>
                                @if (myLocation != null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100 mb-2 py-1" @onclick="CenterOnMyLocation">
                                        <i class="bi bi-crosshair me-1"></i>Center on My Position
                                    </button>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(gpsStatusMessage))
                            {
                                <div class="p-1 mb-2 bg-dark rounded text-light font-monospace small" style="font-size: 0.72rem;">
                                    @gpsStatusMessage
                                </div>
                            }

                            @if (myLocation != null)
                            {
                                <div class="bg-light p-2 rounded mb-2 border text-dark font-monospace" style="font-size: 0.75rem;">
                                    <div><strong>Lat:</strong> @myLocation.Latitude.ToString("F5")</div>
                                    <div><strong>Lng:</strong> @myLocation.Longitude.ToString("F5")</div>
                                    @if (myLocation.Heading.HasValue)
                                    {
                                        <div><strong>Heading:</strong> @(Math.Round(myLocation.Heading.Value))&deg;</div>
                                    }
                                    @if (myLocation.Speed.HasValue)
                                    {
                                        <div><strong>Speed:</strong> @((myLocation.Speed.Value * 3.6).ToString("F1")) km/h</div>
                                    }
                                    @if (myLocation.Accuracy.HasValue)
                                    {
                                        <div><strong>Accuracy:</strong> &plusmn;@Math.Round(myLocation.Accuracy.Value)m</div>
                                    }
                                </div>
                            }

                            <!-- Simulation / Step Movement Tools for Verification -->
                            <div class="border-top pt-2 mt-2">
                                <div class="fw-bold mb-1" style="font-size: 0.75rem;">Move Simulator (Test &gt;10m / &gt;30m):</div>
                                <div class="d-flex justify-content-center gap-1 mb-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => SimulateMove(15, 0)" title="Move 15m North (triggers >10m update)">
                                        <i class="bi bi-arrow-up"></i> +15m N
                                    </button>
                                </div>
                                <div class="d-flex justify-content-center gap-1 mb-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => SimulateMove(0, -15)" title="Move 15m West">
                                        <i class="bi bi-arrow-left"></i> +15m W
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => SimulateMove(0, 15)" title="Move 15m East">
                                        +15m E <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                                <div class="d-flex justify-content-center gap-1 mb-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => SimulateMove(-15, 0)" title="Move 15m South">
                                        <i class="bi bi-arrow-down"></i> +15m S
                                    </button>
                                </div>
                                <div class="d-grid mt-1">
                                    <button type="button" class="btn btn-sm btn-outline-warning py-0" @onclick="() => SimulateMove(35, 0)" title="Move 35m North (triggers >30m unit threshold / radius exit)">
                                        <i class="bi bi-lightning-charge"></i> Move +35m (Unit Update)
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Settings Panel (Extensibility placeholder) -->
                    @if (isSettingsOpen)
                    {
                        <div class="p-2 mb-2 border rounded livemap-panel small">
                            <h6 class="border-bottom pb-1 mb-2 font-weight-bold">Map Settings</h6>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkAutoPan" checked>
                                <label class="form-check-label" for="chkAutoPan">Auto-sync markers</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkShowLabels" checked>
                                <label class="form-check-label" for="chkShowLabels">Show callsign labels</label>
                            </div>
                            <div class="opacity-75 small">Standard MIL-STD-2525C / milsymbol.js engine active.</div>
                        </div>
                    }

                    <!-- Unfoldable Categories of Available Markers -->
                    @if (isMarkerSelectorOpen)
                    {
                        <div class="mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-uppercase fw-bold opacity-75" style="font-size: 0.75rem;">Available Markers</small>
                                <small class="opacity-75" style="font-size: 0.7rem;">Select type to place</small>
                            </div>

                            <div class="accordion accordion-flush border rounded" id="markerCategoriesAccordion">
                                @foreach (var category in categories)
                                {
                                    var isExpanded = expandedCategoryId == category.Id;
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button py-2 px-2 @(isExpanded ? "" : "collapsed") small fw-semibold" type="button" @onclick="() => ToggleCategory(category.Id)">
                                                <i class="bi @category.Icon me-2"></i>
                                                <span class="flex-grow-1 text-truncate">@category.Name</span>
                                                <span class="badge badge-theme ms-1 font-monospace" style="font-size: 0.65rem;">@category.Symbols.Count</span>
                                            </button>
                                        </h2>
                                        @if (isExpanded)
                                        {
                                            <div class="accordion-collapse collapse show">
                                                <div class="accordion-body p-1">
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var symbol in category.Symbols)
                                                        {
                                                            var isSelected = selectedSymbol?.Sidc == symbol.Sidc;
                                                            <button type="button" class="list-group-item list-group-item-action p-2 d-flex align-items-center justify-content-between border-0 rounded mb-1 @(isSelected ? "active" : "")" @onclick="() => SelectSymbolToPlace(symbol)">
                                                                <div class="d-flex align-items-center gap-2 text-truncate">
                                                                    @if (symbolPreviewUrls.TryGetValue(symbol.Sidc, out var imgUrl) && !string.IsNullOrEmpty(imgUrl))
                                                                    {
                                                                        <img src="@imgUrl" alt="@symbol.Name" style="height: 24px; width: 24px; object-fit: contain;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge badge-theme font-monospace" style="font-size: 0.6rem;">@symbol.Sidc.Substring(0, Math.Min(4, symbol.Sidc.Length))</span>
                                                                    }
                                                                    <div class="text-truncate">
                                                                        <div class="small fw-bold text-truncate">@symbol.Name</div>
                                                                        <div class="small opacity-75 text-truncate" style="font-size: 0.7rem;">@symbol.Description</div>
                                                                    </div>
                                                                </div>
                                                                <span class="badge badge-theme font-monospace" style="font-size: 0.6rem;">@symbol.Sidc</span>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- SCREEN ON TOP OF EVERYTHING: Marker Details Modal Dialog                  -->
<!-- ========================================================================= -->
@if (showDetailsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.75); z-index: 2000; backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header py-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(modalPreviewUrl))
                        {
                            <img src="@modalPreviewUrl" alt="Symbol" style="height: 38px; width: 38px; object-fit: contain;" class="p-1 rounded border" />
                        }
                        <div>
                            <h5 class="modal-title mb-0">@(isEditingExisting ? "Edit Tactical Marker" : "Add Tactical Marker Details")</h5>
                            <small class="opacity-75">Saving as PersistentMarker &amp; syncing with group</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDetailsModal"></button>
                </div>

                <div class="modal-body p-4">
                    <form @onsubmit="SaveMarkerDetails">
                        <div class="row g-3">
                            <!-- Marker Name -->
                            <div class="col-md-7">
                                <label class="form-label fw-bold">Marker Name / Callsign <span style="color: var(--front)">*</span></label>
                                <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newMarkerModel.Name) ? "is-invalid" : "")" @bind="newMarkerModel.Name" @bind:event="oninput" placeholder="e.g. 1st Platoon / Alpha Team" required autofocus />
                                <div class="invalid-feedback">Please enter a marker name or callsign.</div>
                            </div>

                            <!-- UnitType / SIDC Selector -->
                            <div class="col-md-5">
                                <label class="form-label fw-bold">Unit Type (milsymbol SIDC)</label>
                                <select class="form-select font-monospace" @bind="newMarkerModel.UnitType" @bind:after="UpdateModalPreview">
                                    @foreach (var cat in categories)
                                    {
                                        <optgroup label="@cat.Name">
                                            @foreach (var sym in cat.Symbols)
                                            {
                                                <option value="@sym.Sidc">@sym.Name (@sym.Sidc)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>

                            <!-- Description / Notes -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Description / Tactical Notes</label>
                                <textarea class="form-control" rows="3" @bind="newMarkerModel.Description" placeholder="Enter tactical remarks, frequency, composition, orders, or mission notes..."></textarea>
                            </div>

                            <!-- Coordinates Info -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small opacity-75">Latitude</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-compass"></i></span>
                                    <input type="number" step="0.000001" class="form-control font-monospace" @bind="newMarkerModel.Latitude" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small opacity-75">Longitude</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-compass-fill"></i></span>
                                    <input type="number" step="0.000001" class="form-control font-monospace" @bind="newMarkerModel.Longitude" />
                                </div>
                            </div>

                            <!-- Persistence and Group Sync Info -->
                            <div class="col-12">
                                <div class="alert livemap-panel py-2 px-3 mb-0 small d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill fs-5" style="color: var(--front);"></i>
                                    <div>
                                        This marker will be saved as <strong>PersistentMarker</strong> with UnitType <code>@newMarkerModel.UnitType</code> and broadcasted in real-time to all connected users in your group.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer py-2 px-3 border-top">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal" disabled="@isSaving">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-4" @onclick="SaveMarkerDetails" disabled="@(isSaving || string.IsNullOrWhiteSpace(newMarkerModel.Name))">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <span>@(isEditingExisting ? "Update Marker" : "Save & Sync Marker")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum MarkerAction
    {
        Move,
        Edit,
        Delete
    }

    private readonly string mapId = "livemap-" + Guid.NewGuid().ToString("N");
    private bool mapInitialized;
    private DotNetObjectReference<LiveMap>? dotNetRef;
    private HubConnection? hubConnection;

    // Toolbox State
    private bool isToolboxExpanded = true;
    private bool isMarkerSelectorOpen = true;
    private bool isSettingsOpen = false;
    private string expandedCategoryId = "friendly_ground";

    // Marker Categories & Definitions
    private List<MarkerCategory> categories = MarkerSymbolDefinitions.GetCategories();
    private Dictionary<string, string> symbolPreviewUrls = new();

    // Placement Mode State
    private bool isPlacementMode = false;
    private MarkerSymbolOption? selectedSymbol;

    // Moving Mode State
    private Guid? movingMarkerId;

    // Context Menu State
    private bool showContextMenu = false;
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private MarkerDto? contextMarker;

    // Modal Details State (Screen on top of everything)
    private bool showDetailsModal = false;
    private bool isEditingExisting = false;
    private bool isSaving = false;
    private MarkerDto newMarkerModel = new();
    private string modalPreviewUrl = string.Empty;

    // Markers state & Group
    private Dictionary<Guid, MarkerDto> markers = new();
    private string currentGroupName = null;
    
    // Geolocation & Unit Live Tracking State
    private Dictionary<Guid, UserLocationDto> userLocations = new();
    private List<LiveUnitMarkerDto> liveUnitMarkers = new();
    private UserLocationDto? myLocation;
    private bool isGpsTracking = false;
    private bool isGpsPanelOpen = false;
    private string? gpsStatusMessage;
    
    protected override async Task OnInitializedAsync()
    {
        // Set default selected symbol
        selectedSymbol = categories.FirstOrDefault()?.Symbols.FirstOrDefault();

        // Initialize SignalR Hub Connection
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/map"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<MarkerDto>("MarkerAdded", async (marker) =>
            {
                markers[marker.Id] = marker;
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, marker);
                }
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<MarkerDto>("MarkerUpdated", async (marker) =>
            {
                markers[marker.Id] = marker;
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, marker);
                }
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<Guid, double, double, DateTime>("MarkerMoved", async (markerId, lat, lng, updated) =>
            {
                if (markers.TryGetValue(markerId, out var existing))
                {
                    existing.Latitude = lat;
                    existing.Longitude = lng;
                    existing.TimeStamp_Updated = updated;
                    if (mapInitialized)
                    {
                        await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, existing);
                    }
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<Guid>("MarkerDeleted", async (markerId) =>
            {
                markers.Remove(markerId);
                if (movingMarkerId == markerId)
                {
                    movingMarkerId = null;
                }
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.removeMarker", mapId, markerId);
                }
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<string?>("GroupNameChanged", async (groupName) =>
            {
                currentGroupName = groupName;
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<string?>("GroupChanged", async (groupName) =>
            {
                currentGroupName = groupName;
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<UserLocationDto>("UserLocationUpdated", async (userLoc) =>
            {
                userLocations[userLoc.UserId] = userLoc;
                bool isSelf = (myLocation != null && myLocation.UserId == userLoc.UserId);
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateUserLocation", mapId, userLoc, isSelf);
                }
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<List<LiveUnitMarkerDto>>("UnitMarkersUpdated", async (unitMarkers) =>
            {
                liveUnitMarkers = unitMarkers ?? new List<LiveUnitMarkerDto>();
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.loadLiveUnitMarkers", mapId, liveUnitMarkers);
                }
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<Guid>("UserLocationRemoved", async (userId) =>
            {
                userLocations.Remove(userId);
                if (mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("liveMap.removeUserLocation", mapId, userId);
                }
                await InvokeAsync(StateHasChanged);
            });
            
            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinGroup");
            await FetchGroupNameAsync();
            
            var initialMarkers = await hubConnection.InvokeAsync<List<MarkerDto>>("GetMarkers");
            if (initialMarkers != null)
            {
                foreach (var m in initialMarkers)
                {
                    markers[m.Id] = m;
                }
            }

            try
            {
                var initialUserLocations = await hubConnection.InvokeAsync<List<UserLocationDto>>("GetUnitUserLocations");
                if (initialUserLocations != null)
                {
                    foreach (var loc in initialUserLocations)
                    {
                        userLocations[loc.UserId] = loc;
                    }
                }

                var initialUnitMarkers = await hubConnection.InvokeAsync<List<LiveUnitMarkerDto>>("GetLiveUnitMarkers");
                if (initialUnitMarkers != null)
                {
                    liveUnitMarkers = initialUnitMarkers;
                }
            }
            catch (Exception locEx)
            {
                Console.WriteLine($"Error fetching initial live locations: {locEx.Message}");
            }
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR init error: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !mapInitialized)
        {
            mapInitialized = true;
            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("liveMap.init", mapId, 47.5, 14.5, 6, dotNetRef);

            // Pre-generate milsymbol preview images for categories
            await LoadSymbolPreviews();

            // Load existing markers onto map
            if (markers.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("liveMap.loadMarkers", mapId, markers.Values.ToList());
            }

            // Load unit user locations
            if (userLocations.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("liveMap.loadUserLocations", mapId, userLocations.Values.ToList(), myLocation?.UserId.ToString());
            }

            // Load live unit markers
            if (liveUnitMarkers.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("liveMap.loadLiveUnitMarkers", mapId, liveUnitMarkers);
            }
        }
    }

    private async Task LoadSymbolPreviews()
    {
        foreach (var cat in categories)
        {
            foreach (var sym in cat.Symbols)
            {
                if (!symbolPreviewUrls.ContainsKey(sym.Sidc))
                {
                    try
                    {
                        var dataUrl = await JSRuntime.InvokeAsync<string>("liveMap.getSymbolDataUrl", sym.Sidc, "", 24);
                        if (!string.IsNullOrEmpty(dataUrl))
                        {
                            symbolPreviewUrls[sym.Sidc] = dataUrl;
                        }
                    }
                    catch
                    {
                        // Ignore preview generation failure
                    }
                }
            }
        }
        StateHasChanged();
    }

