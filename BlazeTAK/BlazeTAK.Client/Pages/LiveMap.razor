    [JSInvokable]
    public async Task OnMarkerContextMenu(string markerIdStr, double relX, double relY, double clientX, double clientY)
    {
        if (Guid.TryParse(markerIdStr, out var markerId) && markers.TryGetValue(markerId, out var marker))
        {
            contextMarker = marker;
            contextMenuX = Math.Max(10, relX);
            contextMenuY = Math.Max(10, relY);
            showContextMenu = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnMarkerDragEnd(string markerIdStr, double newLat, double newLng)
    {
        if (Guid.TryParse(markerIdStr, out var markerId) && markers.TryGetValue(markerId, out var marker))
        {
            marker.Latitude = Math.Round(newLat, 6);
            marker.Longitude = Math.Round(newLng, 6);
            marker.TimeStamp_Updated = DateTime.UtcNow;

            try
            {
                if (hubConnection?.State == HubConnectionState.Connected)
                {
                    await hubConnection.SendAsync("MoveMarker", marker.Id, marker.Latitude, marker.Longitude);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending MoveMarker: {ex.Message}");
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseContextMenu()
    {
        showContextMenu = false;
        contextMarker = null;
    }

    private async Task HandleContextMenuAction(MarkerAction action)
    {
        if (contextMarker == null) return;
        var targetMarker = contextMarker;
        CloseContextMenu();

        switch (action)
        {
            case MarkerAction.Move:
                await StartMoveMarker(targetMarker.Id);
                break;
            case MarkerAction.Edit:
                await EditMarker(targetMarker);
                break;
            case MarkerAction.Delete:
                await DeleteMarker(targetMarker.Id);
                break;
        }
    }

    private async Task StartMoveMarker(Guid markerId)
    {
        // Disable dragging on previous moving marker if any
        if (movingMarkerId.HasValue && movingMarkerId.Value != markerId)
        {
            await JSRuntime.InvokeVoidAsync("liveMap.setMarkerDraggable", mapId, movingMarkerId.Value, false);
        }

        movingMarkerId = markerId;
        await JSRuntime.InvokeVoidAsync("liveMap.setMarkerDraggable", mapId, markerId, true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EndMoveMode()
    {
        if (movingMarkerId.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("liveMap.setMarkerDraggable", mapId, movingMarkerId.Value, false);
            movingMarkerId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EditMarker(MarkerDto marker)
    {
        isEditingExisting = true;
        newMarkerModel = new MarkerDto
        {
            Id = marker.Id,
            Name = marker.Name,
            Description = marker.Description,
            UnitType = marker.UnitType,
            Latitude = marker.Latitude,
            Longitude = marker.Longitude,
            TimeStamp_Created = marker.TimeStamp_Created,
            TimeStamp_Updated = marker.TimeStamp_Updated,
            CreatedById = marker.CreatedById,
            CreatedByName = marker.CreatedByName,
            UnitId = marker.UnitId,
            GroupId = marker.GroupId
        };

        await UpdateModalPreview();
        showDetailsModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteMarker(Guid markerId)
    {
        try
        {
            if (movingMarkerId == markerId)
            {
                await EndMoveMode();
            }

            markers.Remove(markerId);
            if (mapInitialized)
            {
                await JSRuntime.InvokeVoidAsync("liveMap.removeMarker", mapId, markerId);
            }

            if (hubConnection?.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("DeleteMarker", markerId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting marker: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateModalPreview()
    {
        try
        {
            modalPreviewUrl = await JSRuntime.InvokeAsync<string>("liveMap.getSymbolDataUrl", newMarkerModel.UnitType, "", 36);
        }
        catch
        {
            modalPreviewUrl = string.Empty;
        }
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        isSaving = false;
        isEditingExisting = false;
    }

    private async Task SaveMarkerDetails()
    {
        if (string.IsNullOrWhiteSpace(newMarkerModel.Name)) return;

        isSaving = true;
        try
        {
            newMarkerModel.TimeStamp_Updated = DateTime.UtcNow;

            if (hubConnection?.State == HubConnectionState.Connected)
            {
                if (isEditingExisting)
                {
                    var updated = await hubConnection.InvokeAsync<MarkerDto>("UpdateMarker", newMarkerModel);
                    if (updated != null)
                    {
                        markers[updated.Id] = updated;
                        await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, updated);
                    }
                }
                else
                {
                    var savedMarker = await hubConnection.InvokeAsync<MarkerDto>("AddPersistentMarker", newMarkerModel);
                    if (savedMarker != null)
                    {
                        markers[savedMarker.Id] = savedMarker;
                        await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, savedMarker);
                    }
                }
            }
            else
            {
                // Fallback direct render if hub disconnected
                markers[newMarkerModel.Id] = newMarkerModel;
                await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, newMarkerModel);
            }

            showDetailsModal = false;
            isEditingExisting = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving marker: {ex.Message}");
            // Still render locally
            markers[newMarkerModel.Id] = newMarkerModel;
            await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateMarker", mapId, newMarkerModel);
            showDetailsModal = false;
            isEditingExisting = false;
        }
        finally
        {
            isSaving = false;
        }
    }

