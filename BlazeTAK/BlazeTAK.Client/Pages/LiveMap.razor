    public void OnGeolocationError(string error)
    {
        gpsStatusMessage = $"GPS Error: {error}";
        StateHasChanged();
    }

    private async Task SimulateMove(double deltaLatMeters, double deltaLngMeters)
    {
        double baseLat = myLocation?.Latitude ?? 47.5;
        double baseLng = myLocation?.Longitude ?? 14.5;

        // 1 deg lat is ~ 111,320m
        // 1 deg lng is ~ 111,320m * cos(lat)
        double deltaLat = deltaLatMeters / 111320.0;
        double deltaLng = deltaLngMeters / (111320.0 * Math.Cos(baseLat * Math.PI / 180.0));

        double newLat = baseLat + deltaLat;
        double newLng = baseLng + deltaLng;
        double heading = Math.Atan2(deltaLngMeters, deltaLatMeters) * 180.0 / Math.PI;
        if (heading < 0) heading += 360.0;

        await OnLocationChanged(newLat, newLng, heading, 1.5, 5.0);
    }

