    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
        {
            dotNetRef.Dispose();
        }

        if (hubConnection != null)
        {
            try
            {
                await hubConnection.DisposeAsync();
            }
            catch
            {
                // Ignore connection dispose errors
            }
        }

        if (mapInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("liveMap.destroy", mapId);
            }
            catch
            {
                // Ignore map dispose errors
            }
        }
    }
