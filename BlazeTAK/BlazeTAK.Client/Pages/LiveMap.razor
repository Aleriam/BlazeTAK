    [JSInvokable]
    public async Task OnLocationChanged(double lat, double lng, double? heading, double? speed, double? accuracy)
    {
        try
        {
            if (hubConnection?.State == HubConnectionState.Connected)
            {
                var updatedLoc = await hubConnection.InvokeAsync<UserLocationDto?>("UpdateUserLocation", new LocationUpdateDto
                {
                    Latitude = lat,
                    Longitude = lng,
                    Heading = heading,
                    Speed = speed,
                    Accuracy = accuracy
                });

                if (updatedLoc != null)
                {
                    myLocation = updatedLoc;
                    userLocations[updatedLoc.UserId] = updatedLoc;
                    if (mapInitialized)
                    {
                        await JSRuntime.InvokeVoidAsync("liveMap.addOrUpdateUserLocation", mapId, updatedLoc, true);
                    }
                    gpsStatusMessage = $"Position updated: {lat:F5}, {lng:F5}";
                }
            }
        }
        catch (Exception ex)
        {
            gpsStatusMessage = $"Location sync error: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

